# VYBE Music Provider Configuration
# Copy these keys into local.properties (for Gradle builds) or set as environment variables.
# Never commit real API keys or secrets to version control.

# Active music provider ID:
#   dummy       - Built-in DummyMusicProvider with sample catalog & demo streams (default)
#   custom_vybe - Custom REST music streaming backend using VYBE_API_BASE_URL
MUSIC_PROVIDER=dummy

# Base URL for CustomVybeProvider (trailing slash optional), e.g. https://api.yourdomain.com/
VYBE_API_BASE_URL=
